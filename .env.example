# =============================================================
# Corrective RAG Project — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to GitHub!
# =============================================================

# Google AI Studio API Key (free tier)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Embedding model (Google's latest free embedding model)
EMBEDDING_MODEL=models/gemini-embedding-001

# Generation model (fast + free tier)
GENERATION_MODEL=gemini-2.0-flash

# Qdrant vector database settings
# QDRANT_PATH: local directory for persistent storage (no server needed for dev)
# In production (Docker), we'll switch to QDRANT_URL=http://qdrant:6333
QDRANT_PATH=./qdrant_db
QDRANT_COLLECTION_NAME=indian_startups

# Chunking settings
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Retrieval settings
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
